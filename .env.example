# ============================================================
#  AHR Maintenance Inventory — settings
#  Copy this file to ".env" and fill in the values you need.
#  Lines starting with # are ignored. Restart the program after editing.
# ============================================================

APP_NAME=AHR Maintenance Inventory
# IMPORTANT: change this to a long random string (security key for logins)
SECRET_KEY=please-change-this-to-a-long-random-secret-string
# Port the program runs on. 8770 avoids clashing with other apps (e.g. an app on 8000).
PORT=8770

# --- End-of-day summary (24-hour clock, factory local time) ---
EOD_HOUR=18
EOD_MINUTE=0
TIMEZONE=Asia/Bangkok

# Optional: full path to minizinc.exe for the Optimization page (else it looks on PATH).
# Example (Windows): MINIZINC_PATH=C:\Program Files\MiniZinc\minizinc.exe
MINIZINC_PATH=

# --- Reorder tuning ---
REORDER_BUFFER=0
DEAD_STOCK_DAYS=365

# ============================================================
#  Notification channels — leave blank to turn a channel off
# ============================================================

# Discord: create a channel webhook and paste its URL
DISCORD_WEBHOOK=

# Telegram: message @BotFather to get a token, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LINE Messaging API (for push notifications + LINE requisition bot)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# group or user id that end-of-day / reorder summaries are pushed to
LINE_NOTIFY_TARGET=
